{
  "name": "openclaw-plugin-harness-bridge",
  "version": "0.4.1",
  "description": "Register, configure, delegate and monitor coding-agent harnesses from OpenClaw.",
  "type": "module",
  "private": true,
  "author": "李冠华 (Liguanhua)",
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "plugin:build": "npm run build && openclaw plugins build --entry ./dist/index.js",
    "plugin:validate": "npm run build && openclaw plugins validate --entry ./dist/index.js",
    "test": "vitest run --config ./vitest.config.ts"
  },
  "files": [
    "dist",
    "adapters",
    "params",
    "docs",
    "openclaw.plugin.json",
    "README.md",
    "README.zh-CN.md"
  ],
  "peerDependencies": {
    "openclaw": ">=2026.5.17"
  },
  "dependencies": {
    "typebox": "^1.1.38"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "js-yaml": "^5.5.0",
    "openclaw": "2026.7.1-2",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.5.17"
    },
    "build": {
      "openclawVersion": "2026.7.1-2"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SilenceUrStep/openclaw-harness-bridge.git"
  },
  "homepage": "https://github.com/SilenceUrStep/openclaw-harness-bridge#readme",
  "bugs": "https://github.com/SilenceUrStep/openclaw-harness-bridge/issues",
  "keywords": [
    "openclaw",
    "plugin",
    "harness",
    "opencode",
    "claude-code",
    "codex",
    "orchestration",
    "coding-agent"
  ]
}
