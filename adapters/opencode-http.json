{
  "id": "opencode",
  "displayName": "OpenCode",
  "capabilities": ["coding"],
  "description": "OpenCode serve 模式（HTTP 直调 + SSE 事件流 + 事件级台账）；探活失败自动回落 cli",
  "schemaVersion": 2,
  "binary": "opencode",
  "versionCheck": ["opencode", "--version"],
  "transport": {
    "type": "http",
    "baseUrl": "http://127.0.0.1:4096",
    "auth": {
      "type": "basic",
      "usernameEnv": "OPENCODE_SERVER_USERNAME",
      "passwordEnv": "OPENCODE_SERVER_PASSWORD"
    },
    "directoryHeader": "x-opencode-directory",
    "healthCheck": { "method": "GET", "path": "/session", "expectStatus": 200 },
    "fallback": { "type": "cli" }
  },
  "delegate": {
    "run": ["opencode", "run", "{prompt}"],
    "resume": ["opencode", "run", "-s", "{sessionId}", "{prompt}"],
    "timeoutMs": 600000
  },
  "config": {
    "modelConfig": {
      "path": "~/.config/opencode/opencode.json",
      "format": "opencode-json",
      "modelsPointer": "$.provider.*.models",
      "fieldMap": { "contextWindow": "context", "maxTokens": "maxTokensOutput" },
      "defaultModelPointer": "$.model"
    },
    "mount": {
      "configPath": "~/.config/opencode/opencode.json",
      "format": "opencode-json",
      "externalDirectoryPointer": "$.permission.external_directory",
      "instructionsPointer": "$.instructions"
    }
  },
  "session": { "idPattern": "ses_[a-zA-Z0-9]+" }
}
